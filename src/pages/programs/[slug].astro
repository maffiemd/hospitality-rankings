---
import Layout from "../../layouts/Layout.astro";
import rankingsData from "../../../data/generated/rankings.json";
import type { RankingsOutput } from "../../lib/types";
import { getMetric } from "../../lib/metricPath";
import { href } from "../../lib/url";

export function getStaticPaths() {
  const data = rankingsData as RankingsOutput;
  return data.rankings.map((r) => ({
    params: { slug: r.program.slug },
    props: { ranking: r },
  }));
}

const { ranking } = Astro.props;
const { program } = ranking;
---

<Layout title={program.institution}>
  <p class="back"><a href={href("/")}>&larr; Back to rankings</a></p>
  <span class="eyebrow">{ranking.rank !== null ? `Ranked #${ranking.rank}` : "Not yet ranked"}</span>
  <h1 class="display">{program.institution}</h1>
  <p class="institution">{program.name} &middot; {program.country}</p>
  <p>
    <a href={program.website} target="_blank" rel="noopener noreferrer">{program.website}</a>
  </p>

  <div class="score-banner">
    <div>
      <span class="big">{ranking.rank ?? "Unranked"}</span>
      <span class="label">Rank</span>
    </div>
    <div>
      <span class="big">{ranking.compositeScore?.toFixed(1) ?? "—"}</span>
      <span class="label">Composite score{ranking.rank === null && ranking.compositeScore !== null ? " (informational — see note below)" : ""}</span>
    </div>
    <div>
      <span class="big">{Math.round(ranking.dataCompleteness * 100)}%</span>
      <span class="label">Data completeness</span>
    </div>
  </div>

  {
    ranking.rank === null && (
      <p class="unranked-note">
        This program isn't yet eligible for a numeric rank — too few of the tracked metrics have a
        sourced value (see the <a href={href("/methodology/")}>methodology</a>). The composite score above is
        shown for transparency but shouldn't be compared directly to a ranked program's score.
      </p>
    )
  }

  {
    ranking.categories.map((category) => (
      <section>
        <h2><span class="marker">&#9656;</span> {category.label}{category.score !== null ? ` — ${category.score.toFixed(1)}` : " (no data yet)"}</h2>
        <table>
          <thead>
            <tr>
              <th>Metric</th>
              <th>Value</th>
              <th>Normalized</th>
              <th>Confidence</th>
              <th>Source</th>
            </tr>
          </thead>
          <tbody>
            {category.metrics.map((m) => {
              const metric = getMetric(program, m.path);
              return (
                <tr>
                  <td>{m.path}</td>
                  <td>{m.rawValue !== null ? `${m.rawValue} ${metric?.unit ?? ""}` : "Not yet sourced"}</td>
                  <td>{m.normalized !== null ? m.normalized.toFixed(0) : "—"}</td>
                  <td>{metric?.confidence ?? "—"}</td>
                  <td>
                    {metric?.source ? (
                      <a href={metric.source.url} target="_blank" rel="noopener noreferrer">
                        {metric.source.label}
                      </a>
                    ) : (
                      "—"
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        {category.metrics.some((m) => getMetric(program, m.path)?.notes) && (
          <ul class="notes">
            {category.metrics
              .filter((m) => getMetric(program, m.path)?.notes)
              .map((m) => (
                <li>
                  <strong>{m.path}:</strong> {getMetric(program, m.path)?.notes}
                </li>
              ))}
          </ul>
        )}
      </section>
    ))
  }
</Layout>

<style>
  .back {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .back a {
    color: var(--fg);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--accent);
  }

  .display {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0 0 0.5rem;
  }

  .institution {
    color: var(--muted);
  }

  .score-banner {
    display: flex;
    gap: 2.5rem;
    margin: 1.5rem 0 2.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .unranked-note {
    background: var(--accent-bg);
    border-left: 3px solid var(--accent);
    padding: 0.9rem 1rem;
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .score-banner .big {
    display: block;
    font-family: var(--font-serif);
    font-size: 2.3rem;
    color: var(--accent);
  }

  .score-banner .label {
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  section {
    margin-bottom: 2.5rem;
  }

  section h2 {
    font-size: 1.25rem;
  }

  .marker {
    color: var(--accent);
    display: inline-block;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  th {
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    border-bottom: 2px solid var(--accent);
  }

  .notes {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--muted);
    padding-left: 1.1rem;
  }
</style>
