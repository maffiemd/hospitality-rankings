---
import Layout from "../layouts/Layout.astro";
import rankingsData from "../../data/generated/rankings.json";
import type { RankingsOutput } from "../lib/types";
import { CATEGORIES, MIN_COMPLETENESS_FOR_RANK } from "../config/weights";
import { href } from "../lib/url";

const data = rankingsData as RankingsOutput;
const ranked = data.rankings.filter((r) => r.rank !== null).sort((a, b) => (a.rank as number) - (b.rank as number));
const unranked = data.rankings
  .filter((r) => r.rank === null)
  .sort((a, b) => a.program.institution.localeCompare(b.program.institution));
const generated = new Date(data.generatedAt);
---

<Layout title="Rankings">
  <span class="eyebrow">Undergraduate &middot; Global &middot; Source-cited</span>
  <h1 class="display">Hospitality Education, <em>Open Rankings</em></h1>
  <p class="subhead">
    A composite ranking of hospitality &amp; hotel administration programs combining career outcomes,
    academic research, admissions selectivity, and internship/placement pipeline strength. See the <a href={href("/methodology/")}>methodology</a> for weights and the <a href={href("/sources/")}>sources</a> page for every citation.
  </p>
  <p class="meta">
    Rankings last computed on {generated.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
    &middot; {ranked.length} of {data.programCount} programs ranked
  </p>

  <p class="cta"><a class="btn-outline" href={href("/methodology/")}>How it's scored</a></p>

  <section class="customize" id="customize">
    <h2><span class="marker">&#9656;</span> Build your own ranking</h2>
    <p class="subhead">
      Drag any slider to weight that category more or less heavily — the table below re-sorts live.
      Weights don't need to add up to 100%; they're normalized automatically against each other. This
      only reorders the {ranked.length} already-ranked programs below; it can't promote a program out
      of <a href="#unranked">not yet ranked</a>, since that's about missing data, not what you value.
    </p>
    <div class="sliders" role="group" aria-label="Category weights">
      {
        CATEGORIES.map((c) => (
          <div class="slider-row">
            <div class="slider-label">
              <label for={`weight-${c.key}`}>{c.label}</label>
              <span class="slider-value" id={`value-${c.key}`}>{Math.round(c.weight * 100)}%</span>
            </div>
            <input
              type="range"
              id={`weight-${c.key}`}
              data-category={c.key}
              min="0"
              max="100"
              step="5"
              value={Math.round(c.weight * 100)}
            />
          </div>
        ))
      }
    </div>
    <button type="button" class="btn-outline" id="reset-weights">Reset to default weights</button>
  </section>

  <table id="rankings-table">
    <thead>
      <tr>
        <th data-key="rank" aria-sort="ascending">Rank</th>
        <th data-key="name">Program</th>
        <th data-key="composite">Composite Score</th>
        <th data-key="outcomes" class="mobile-hide">Outcomes</th>
        <th data-key="academicResearch" class="mobile-hide">Research</th>
        <th data-key="academicQuality" class="mobile-hide">Academic Quality</th>
        <th data-key="admissions" class="mobile-hide">Admissions</th>
        <th data-key="placement" class="mobile-hide">Placement</th>
        <th data-key="completeness" class="mobile-hide">Data Completeness</th>
      </tr>
    </thead>
    <tbody>
      {
        ranked.map((r) => {
          const cat = (key: string) => r.categories.find((c) => c.key === key)?.score;
          return (
            <tr
              data-rank={r.rank ?? ""}
              data-composite={r.compositeScore ?? ""}
              data-outcomes={cat("outcomes") ?? ""}
              data-academicresearch={cat("academicResearch") ?? ""}
              data-academicquality={cat("academicQuality") ?? ""}
              data-admissions={cat("admissions") ?? ""}
              data-placement={cat("placement") ?? ""}
              data-completeness={r.dataCompleteness}
            >
              <td>{r.rank ?? "—"}</td>
              <td>
                <a href={href(`/programs/${r.program.slug}/`)}>{r.program.institution}</a>
                <div class="institution">{r.program.name}</div>
              </td>
              <td class="score">{r.compositeScore?.toFixed(1) ?? "—"}</td>
              <td class="mobile-hide">{cat("outcomes")?.toFixed(0) ?? "—"}</td>
              <td class="mobile-hide">{cat("academicResearch")?.toFixed(0) ?? "—"}</td>
              <td class="mobile-hide">{cat("academicQuality")?.toFixed(0) ?? "—"}</td>
              <td class="mobile-hide">{cat("admissions")?.toFixed(0) ?? "—"}</td>
              <td class="mobile-hide">{cat("placement")?.toFixed(0) ?? "—"}</td>
              <td class="mobile-hide">{Math.round(r.dataCompleteness * 100)}%</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>

  {
    unranked.length > 0 && (
      <section class="unranked" id="unranked">
        <h2><span class="marker">&#9656;</span> Not yet ranked — insufficient data</h2>
        <p class="subhead">
          These programs have fewer than {Math.round(MIN_COMPLETENESS_FOR_RANK * 100)}% of tracked metrics sourced, which isn't enough
          to compute a meaningful composite score against better-documented programs (see <a href={href("/methodology/")}>methodology</a>). They're listed here, alphabetically, with whatever has been
          verified so far — not penalized with a low rank, and not given an inflated one either.
        </p>
        <table>
          <thead>
            <tr>
              <th>Program</th>
              <th>Data completeness</th>
            </tr>
          </thead>
          <tbody>
            {unranked.map((r) => (
              <tr>
                <td>
                  <a href={href(`/programs/${r.program.slug}/`)}>{r.program.institution}</a>
                  <div class="institution">{r.program.name}</div>
                </td>
                <td>{Math.round(r.dataCompleteness * 100)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )
  }
</Layout>

<script>
  import { weightedAverage } from "../lib/normalize";

  const table = document.getElementById("rankings-table") as HTMLTableElement;
  const headers = table.querySelectorAll<HTMLTableCellElement>("th[data-key]");
  const tbody = table.querySelector("tbody")!;
  const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>("tr"));

  const columnToAttr: Record<string, string> = {
    rank: "data-rank",
    composite: "data-composite",
    outcomes: "data-outcomes",
    academicResearch: "data-academicresearch",
    academicQuality: "data-academicquality",
    admissions: "data-admissions",
    placement: "data-placement",
    completeness: "data-completeness",
  };

  // ---- Column sort (clicking a header) ----
  let currentKey = "rank";
  let ascending = true;

  function sortBy(key: string) {
    const attr = columnToAttr[key];
    if (!attr) return; // "name" column is not sortable
    ascending = key === currentKey ? !ascending : true;
    currentKey = key;

    rows.sort((a, b) => {
      const av = parseFloat(a.getAttribute(attr) ?? "");
      const bv = parseFloat(b.getAttribute(attr) ?? "");
      const aMissing = Number.isNaN(av);
      const bMissing = Number.isNaN(bv);
      if (aMissing && bMissing) return 0;
      if (aMissing) return 1; // missing values always sort last
      if (bMissing) return -1;
      return ascending ? av - bv : bv - av;
    });
    rows.forEach((row) => tbody.appendChild(row));

    headers.forEach((h) => h.removeAttribute("aria-sort"));
    const activeHeader = table.querySelector(`th[data-key="${key}"]`);
    activeHeader?.setAttribute("aria-sort", ascending ? "ascending" : "descending");
  }

  headers.forEach((h) => {
    h.style.cursor = "pointer";
    h.addEventListener("click", () => sortBy(h.dataset.key!));
  });

  // ---- Build-your-own-ranking sliders ----
  const sliders = Array.from(document.querySelectorAll<HTMLInputElement>("#customize input[type=range]"));
  const resetButton = document.getElementById("reset-weights") as HTMLButtonElement;
  const defaultWeights = new Map(sliders.map((s) => [s.dataset.category!, Number(s.value)]));

  const CATEGORY_KEYS = sliders.map((s) => s.dataset.category!);

  function readWeights(): Record<string, number> {
    const weights: Record<string, number> = {};
    for (const s of sliders) weights[s.dataset.category!] = Number(s.value);
    return weights;
  }

  function updateSliderLabels(weights: Record<string, number>) {
    const sum = CATEGORY_KEYS.reduce((t, k) => t + weights[k], 0);
    for (const key of CATEGORY_KEYS) {
      const label = document.getElementById(`value-${key}`);
      if (!label) continue;
      const pct = sum === 0 ? 0 : (weights[key] / sum) * 100;
      label.textContent = `${Math.round(pct)}%`;
    }
  }

  function recompute() {
    const weights = readWeights();
    updateSliderLabels(weights);

    for (const row of rows) {
      const pairs = CATEGORY_KEYS.map((key) => {
        const attr = columnToAttr[key];
        const raw = row.getAttribute(attr);
        const value = raw === null || raw === "" ? null : Number(raw);
        return { value, weight: weights[key] };
      });
      const composite = weightedAverage(pairs);
      row.setAttribute("data-composite", composite === null ? "" : String(composite));
      const scoreCell = row.querySelector("td.score");
      if (scoreCell) scoreCell.textContent = composite === null ? "—" : composite.toFixed(1);
    }

    // Re-sort by the freshly-recomputed composite and renumber ranks sequentially.
    rows.sort((a, b) => {
      const av = parseFloat(a.getAttribute("data-composite") ?? "");
      const bv = parseFloat(b.getAttribute("data-composite") ?? "");
      const aMissing = Number.isNaN(av);
      const bMissing = Number.isNaN(bv);
      if (aMissing && bMissing) return 0;
      if (aMissing) return 1;
      if (bMissing) return -1;
      return bv - av;
    });
    rows.forEach((row, i) => {
      row.setAttribute("data-rank", String(i + 1));
      const rankCell = row.querySelector("td:first-child");
      if (rankCell) rankCell.textContent = String(i + 1);
      tbody.appendChild(row);
    });

    currentKey = "composite";
    ascending = false;
    headers.forEach((h) => h.removeAttribute("aria-sort"));
    table.querySelector('th[data-key="composite"]')?.setAttribute("aria-sort", "descending");

    syncUrl(weights);
  }

  function syncUrl(weights: Record<string, number>) {
    const params = new URLSearchParams(location.search);
    const isDefault = CATEGORY_KEYS.every((k) => weights[k] === defaultWeights.get(k));
    if (isDefault) {
      params.delete("w");
    } else {
      params.set("w", CATEGORY_KEYS.map((k) => weights[k]).join(","));
    }
    const query = params.toString();
    history.replaceState(null, "", query ? `?${query}` : location.pathname);
  }

  function applyFromUrl() {
    const params = new URLSearchParams(location.search);
    const w = params.get("w");
    if (!w) return;
    const values = w.split(",").map(Number);
    if (values.length !== sliders.length || values.some((v) => Number.isNaN(v))) return;
    sliders.forEach((s, i) => (s.value = String(values[i])));
  }

  sliders.forEach((s) => s.addEventListener("input", recompute));
  resetButton.addEventListener("click", () => {
    sliders.forEach((s) => s.value = String(defaultWeights.get(s.dataset.category!)));
    recompute();
  });

  applyFromUrl();
  recompute();
</script>

<style>
  .display {
    font-size: clamp(2.1rem, 4.5vw, 3.2rem);
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .subhead {
    color: var(--muted);
    max-width: 40em;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .cta {
    margin: 1.5rem 0 2rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.5rem;
    font-size: 0.95rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  th {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    user-select: none;
  }

  th[aria-sort="ascending"]::after {
    content: " \25B2";
  }

  th[aria-sort="descending"]::after {
    content: " \25BC";
  }

  td.score,
  td:nth-child(3) {
    font-weight: 600;
  }

  #rankings-table tbody tr td:first-child {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--accent);
  }

  .institution {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .unranked {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .unranked h2 {
    font-size: 1.4rem;
  }

  .marker {
    color: var(--accent);
    display: inline-block;
  }

  .customize {
    margin-top: 3rem;
    padding: 1.5rem;
    background: var(--accent-bg);
    border-left: 3px solid var(--accent);
  }

  .customize h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
  }

  .customize .subhead {
    margin-top: 0;
    max-width: none;
  }

  .sliders {
    display: grid;
    gap: 1.1rem;
    margin: 1.5rem 0;
  }

  .slider-row {
    display: grid;
    gap: 0.3rem;
  }

  .slider-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.85rem;
  }

  .slider-label label {
    font-weight: 600;
  }

  .slider-value {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--accent);
    min-width: 3ch;
    text-align: right;
  }

  .sliders input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
    cursor: pointer;
    height: 1.25rem;
  }

  @media (max-width: 640px) {
    .mobile-hide {
      display: none;
    }

    table {
      font-size: 0.85rem;
    }

    th,
    td {
      padding: 0.5rem 0.4rem;
    }

    .customize {
      padding: 1.1rem;
      margin-left: -1rem;
      margin-right: -1rem;
    }
  }
</style>
