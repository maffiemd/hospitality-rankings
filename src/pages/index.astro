---
import Layout from "../layouts/Layout.astro";
import rankingsData from "../../data/generated/rankings.json";
import type { RankingsOutput } from "../lib/types";
import { CATEGORIES, MIN_COMPLETENESS_FOR_RANK } from "../config/weights";
import { href } from "../lib/url";

const data = rankingsData as RankingsOutput;
const ranked = data.rankings.filter((r) => r.rank !== null).sort((a, b) => (a.rank as number) - (b.rank as number));
const unranked = data.rankings
  .filter((r) => r.rank === null)
  .sort((a, b) => a.program.institution.localeCompare(b.program.institution));
const generated = new Date(data.generatedAt);

/** Turns a metric dot-path into a DOM-safe id/attribute fragment, e.g. "outcomes.startingSalary" -> "outcomes-startingSalary". */
const metricKey = (path: string) => path.replace(/\./g, "-");

/** Looks up a program's normalized (0-100) score for one metric, wherever it lives in its categories. */
function metricNormalized(r: RankingsOutput["rankings"][number], path: string): number | undefined {
  for (const c of r.categories) {
    const m = c.metrics.find((mm) => mm.path === path);
    if (m) return m.normalized ?? undefined;
  }
  return undefined;
}
---

<Layout title="Compare">
  <span class="eyebrow">Undergraduate &middot; Global &middot; Source-cited</span>
  <h1 class="display">Find the Hospitality Program That <em>Fits You</em></h1>
  <p class="subhead">
    Hospitality is in the service of others. In that spirit, this tool exists to help students discover
    the hospitality program that <em>fits them best</em>. Compare hospitality &amp; hotel administration
    programs by career outcomes, academic research, admissions selectivity, and internship/placement
    pipeline strength, weighted however matters most to you. See the <a href={href("/methodology/")}>methodology</a> and the <a href={href("/sources/")}>sources</a> page for every citation.
  </p>
  <p class="subhead">
    Service is life. We're glad you're considering a career in hospitality and hotel administration.
    Wherever you land, we hope it's the right fit.
  </p>

  <p class="cta"><a class="btn-outline" href={href("/methodology/")}>How it's scored</a></p>

  <section class="customize" id="customize">
    <h2><span class="marker">&#9656;</span> Build your shortlist</h2>
    <p class="subhead">
      Every comparison is a choice about what matters. Rather than default to ours, nothing's shown below
      until you set your own priorities — drag what you care about, leave the rest at zero. Weights
      don't need to add up to 100%; they're normalized against each other automatically.
    </p>
    <div class="sliders" role="group" aria-label="Category weights">
      {
        CATEGORIES.map((c) => (
          <div class="category-block">
            <div class="slider-row">
              <label for={`weight-${c.key}`}>{c.label}</label>
              <input type="range" id={`weight-${c.key}`} data-category={c.key} min="0" max="100" step="5" value="0" />
              <span class="slider-value" id={`value-${c.key}`}>0%</span>
            </div>
            {c.metrics.length > 1 && (
              <div class="subweight-list" hidden>
                <p class="subweight-label">Sub-category weights</p>
                {c.metrics.map((m) => (
                  <div class="slider-row sub">
                    <label for={`sub-${metricKey(m.path)}`}>
                      {m.label}
                      {m.direction === "lowerIsBetter" ? " (lower is better)" : ""}
                    </label>
                    <input
                      type="range"
                      id={`sub-${metricKey(m.path)}`}
                      data-subweight-category={c.key}
                      data-metric={m.path}
                      min="0"
                      max="100"
                      step="5"
                      value={Math.round(m.weight * 100)}
                    />
                    <span class="slider-value" id={`subvalue-${metricKey(m.path)}`}>
                      {Math.round(m.weight * 100)}%
                    </span>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
    <div class="customize-actions">
      <button type="button" class="btn-outline advanced-toggle" id="toggle-advanced" aria-expanded="false">Advanced</button>
      <button type="button" class="btn-solid" id="build-ranking" disabled>
        Build my shortlist
      </button>
      <button type="button" class="btn-outline" id="reset-weights">Start over</button>
    </div>
    <p class="customize-hint" id="customize-hint">Move at least one slider above zero to continue.</p>
  </section>

  <div id="results" hidden>
    <p class="meta">
      Rankings last computed on {generated.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      &middot; <span id="ranked-count">{ranked.length}</span> of {data.programCount} programs ranked by your weights
    </p>

    <table id="rankings-table">
      <thead>
        <tr>
          <th data-key="rank" aria-sort="descending">Rank</th>
          <th data-key="name">Program</th>
          <th data-key="composite">Fit Score</th>
          <th data-key="outcomes" class="mobile-hide">Outcomes</th>
          <th data-key="academicResearch" class="mobile-hide">Research</th>
          <th data-key="academicQuality" class="mobile-hide">Academic Quality</th>
          <th data-key="admissions" class="mobile-hide">Admissions</th>
          <th data-key="placement" class="mobile-hide">Placement</th>
          <th data-key="completeness" class="mobile-hide">Data Completeness</th>
        </tr>
      </thead>
      <tbody>
        {
          ranked.map((r) => {
            const cat = (key: string) => r.categories.find((c) => c.key === key)?.score;
            const metricAttrs: Record<string, number | string> = {};
            for (const c of CATEGORIES) {
              for (const m of c.metrics) {
                metricAttrs[`data-m-${metricKey(m.path)}`] = metricNormalized(r, m.path) ?? "";
              }
            }
            return (
              <tr
                data-rank={r.rank ?? ""}
                data-composite={r.compositeScore ?? ""}
                data-outcomes={cat("outcomes") ?? ""}
                data-academicresearch={cat("academicResearch") ?? ""}
                data-academicquality={cat("academicQuality") ?? ""}
                data-admissions={cat("admissions") ?? ""}
                data-placement={cat("placement") ?? ""}
                data-completeness={r.dataCompleteness}
                {...metricAttrs}
              >
                <td>{r.rank ?? "—"}</td>
                <td>
                  <a href={href(`/programs/${r.program.slug}/`)}>{r.program.institution}</a>
                  <div class="institution">{r.program.name}</div>
                </td>
                <td class="score">{r.compositeScore?.toFixed(1) ?? "—"}</td>
                <td class="mobile-hide" data-col="outcomes">{cat("outcomes")?.toFixed(0) ?? "—"}</td>
                <td class="mobile-hide" data-col="academicResearch">{cat("academicResearch")?.toFixed(0) ?? "—"}</td>
                <td class="mobile-hide" data-col="academicQuality">{cat("academicQuality")?.toFixed(0) ?? "—"}</td>
                <td class="mobile-hide" data-col="admissions">{cat("admissions")?.toFixed(0) ?? "—"}</td>
                <td class="mobile-hide" data-col="placement">{cat("placement")?.toFixed(0) ?? "—"}</td>
                <td class="mobile-hide">{Math.round(r.dataCompleteness * 100)}%</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>

    {
      unranked.length > 0 && (
        <section class="unranked" id="unranked">
          <h2><span class="marker">&#9656;</span> Not yet ranked — insufficient data</h2>
          <p class="subhead">
            These programs have fewer than {Math.round(MIN_COMPLETENESS_FOR_RANK * 100)}% of tracked metrics sourced, which isn't enough
            to compute a meaningful composite score against better-documented programs (see <a href={href("/methodology/")}>methodology</a>). They're listed here, alphabetically, with whatever has been
            verified so far — not penalized with a low rank, and not given an inflated one either. No
            weighting changes this; it's about missing data, not what you value.
          </p>
          <table>
            <thead>
              <tr>
                <th>Program</th>
                <th>Data completeness</th>
              </tr>
            </thead>
            <tbody>
              {unranked.map((r) => (
                <tr>
                  <td>
                    <a href={href(`/programs/${r.program.slug}/`)}>{r.program.institution}</a>
                    <div class="institution">{r.program.name}</div>
                  </td>
                  <td>{Math.round(r.dataCompleteness * 100)}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }
  </div>
</Layout>

<script>
  import { weightedAverage } from "../lib/normalize";
  import { CATEGORIES } from "../config/weights";

  const metricKey = (path: string) => path.replace(/\./g, "-");

  const table = document.getElementById("rankings-table") as HTMLTableElement;
  const headers = table.querySelectorAll<HTMLTableCellElement>("th[data-key]");
  const tbody = table.querySelector("tbody")!;
  const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>("tr"));

  const columnToAttr: Record<string, string> = {
    rank: "data-rank",
    composite: "data-composite",
    outcomes: "data-outcomes",
    academicResearch: "data-academicresearch",
    academicQuality: "data-academicquality",
    admissions: "data-admissions",
    placement: "data-placement",
    completeness: "data-completeness",
  };

  // ---- Column sort (clicking a header) ----
  let currentKey = "rank";
  let ascending = true;

  function sortBy(key: string) {
    const attr = columnToAttr[key];
    if (!attr) return; // "name" column is not sortable
    ascending = key === currentKey ? !ascending : true;
    currentKey = key;

    rows.sort((a, b) => {
      const av = parseFloat(a.getAttribute(attr) ?? "");
      const bv = parseFloat(b.getAttribute(attr) ?? "");
      const aMissing = Number.isNaN(av);
      const bMissing = Number.isNaN(bv);
      if (aMissing && bMissing) return 0;
      if (aMissing) return 1; // missing values always sort last
      if (bMissing) return -1;
      return ascending ? av - bv : bv - av;
    });
    rows.forEach((row) => tbody.appendChild(row));

    headers.forEach((h) => h.removeAttribute("aria-sort"));
    const activeHeader = table.querySelector(`th[data-key="${key}"]`);
    activeHeader?.setAttribute("aria-sort", ascending ? "ascending" : "descending");
  }

  headers.forEach((h) => {
    h.style.cursor = "pointer";
    h.addEventListener("click", () => sortBy(h.dataset.key!));
  });

  // ---- Build-your-own-ranking sliders (category weights + per-metric sub-weights) ----
  const categorySliders = Array.from(document.querySelectorAll<HTMLInputElement>("#customize input[data-category]"));
  const subSliders = Array.from(document.querySelectorAll<HTMLInputElement>("#customize input[data-subweight-category]"));
  const buildButton = document.getElementById("build-ranking") as HTMLButtonElement;
  const resetButton = document.getElementById("reset-weights") as HTMLButtonElement;
  const advancedToggle = document.getElementById("toggle-advanced") as HTMLButtonElement;
  const subweightLists = Array.from(document.querySelectorAll<HTMLElement>(".subweight-list"));
  const hint = document.getElementById("customize-hint")!;
  const results = document.getElementById("results") as HTMLDivElement;
  const rankedCount = document.getElementById("ranked-count")!;

  const CATEGORY_KEYS = categorySliders.map((s) => s.dataset.category!);
  // Multi-metric categories (the ones with a sub-weight block in the markup).
  const SUBWEIGHTED_CATEGORIES = CATEGORIES.filter((c) => c.metrics.length > 1);
  const DEFAULT_SUBWEIGHTS: Record<string, number> = {};
  for (const c of SUBWEIGHTED_CATEGORIES) {
    for (const m of c.metrics) DEFAULT_SUBWEIGHTS[m.path] = Math.round(m.weight * 100);
  }
  let hasBuilt = false;
  let advancedMode = false;

  function setAdvancedMode(on: boolean) {
    advancedMode = on;
    subweightLists.forEach((el) => (el.hidden = !on));
    advancedToggle.setAttribute("aria-expanded", String(on));
    advancedToggle.textContent = on ? "Hide advanced" : "Advanced";
  }

  function readWeights(): Record<string, number> {
    const weights: Record<string, number> = {};
    for (const s of categorySliders) weights[s.dataset.category!] = Number(s.value);
    return weights;
  }

  function readSubWeights(): Record<string, number> {
    const weights: Record<string, number> = {};
    for (const s of subSliders) weights[s.dataset.metric!] = Number(s.value);
    return weights;
  }

  function totalWeight(weights: Record<string, number>): number {
    return CATEGORY_KEYS.reduce((t, k) => t + weights[k], 0);
  }

  function updateSliderLabels(weights: Record<string, number>, subWeights: Record<string, number>) {
    const sum = totalWeight(weights);
    for (const key of CATEGORY_KEYS) {
      const label = document.getElementById(`value-${key}`);
      if (!label) continue;
      const pct = sum === 0 ? 0 : (weights[key] / sum) * 100;
      label.textContent = `${Math.round(pct)}%`;
    }
    for (const c of SUBWEIGHTED_CATEGORIES) {
      const catSum = c.metrics.reduce((t, m) => t + subWeights[m.path], 0);
      for (const m of c.metrics) {
        const label = document.getElementById(`subvalue-${metricKey(m.path)}`);
        if (!label) continue;
        const pct = catSum === 0 ? 0 : (subWeights[m.path] / catSum) * 100;
        label.textContent = `${Math.round(pct)}%`;
      }
    }
  }

  /** A category's score for one row, recomputed from its metrics using current sub-weights (falls back to the metric's default weight for categories with no sub-weight sliders, i.e. single-metric categories). */
  function categoryScoreForRow(
    row: HTMLTableRowElement,
    category: (typeof CATEGORIES)[number],
    subWeights: Record<string, number>,
  ): number | null {
    const pairs = category.metrics.map((m) => {
      const raw = row.getAttribute(`data-m-${metricKey(m.path)}`);
      const value = raw === null || raw === "" ? null : Number(raw);
      const weight = subWeights[m.path] ?? m.weight;
      return { value, weight };
    });
    return weightedAverage(pairs);
  }

  function recompute() {
    const weights = readWeights();
    const subWeights = readSubWeights();
    updateSliderLabels(weights, subWeights);

    for (const row of rows) {
      const categoryScores: Record<string, number | null> = {};
      for (const c of CATEGORIES) {
        const score = categoryScoreForRow(row, c, subWeights);
        categoryScores[c.key] = score;
        row.setAttribute(columnToAttr[c.key], score === null ? "" : String(score));
        const cell = row.querySelector<HTMLTableCellElement>(`td[data-col="${c.key}"]`);
        if (cell) cell.textContent = score === null ? "—" : score.toFixed(0);
      }

      const composite = weightedAverage(CATEGORIES.map((c) => ({ value: categoryScores[c.key], weight: weights[c.key] })));
      row.setAttribute("data-composite", composite === null ? "" : String(composite));
      const scoreCell = row.querySelector("td.score");
      if (scoreCell) scoreCell.textContent = composite === null ? "—" : composite.toFixed(1);
    }

    // Re-sort by the freshly-recomputed composite and renumber ranks sequentially.
    rows.sort((a, b) => {
      const av = parseFloat(a.getAttribute("data-composite") ?? "");
      const bv = parseFloat(b.getAttribute("data-composite") ?? "");
      const aMissing = Number.isNaN(av);
      const bMissing = Number.isNaN(bv);
      if (aMissing && bMissing) return 0;
      if (aMissing) return 1;
      if (bMissing) return -1;
      return bv - av;
    });
    const eligible = rows.filter((r) => r.getAttribute("data-composite") !== "");
    rankedCount.textContent = String(eligible.length);
    rows.forEach((row, i) => {
      row.setAttribute("data-rank", String(i + 1));
      const rankCell = row.querySelector("td:first-child");
      if (rankCell) rankCell.textContent = String(i + 1);
      tbody.appendChild(row);
    });

    currentKey = "composite";
    ascending = false;
    headers.forEach((h) => h.removeAttribute("aria-sort"));
    table.querySelector('th[data-key="composite"]')?.setAttribute("aria-sort", "descending");

    syncUrl(weights, subWeights);
  }

  function syncUrl(weights: Record<string, number>, subWeights: Record<string, number>) {
    const params = new URLSearchParams(location.search);
    params.set("w", CATEGORY_KEYS.map((k) => weights[k]).join(","));
    const subChanged = Object.keys(DEFAULT_SUBWEIGHTS).some((path) => subWeights[path] !== DEFAULT_SUBWEIGHTS[path]);
    if (subChanged) {
      const order = SUBWEIGHTED_CATEGORIES.flatMap((c) => c.metrics.map((m) => m.path));
      params.set("m", order.map((path) => subWeights[path]).join(","));
    } else {
      params.delete("m");
    }
    const query = params.toString();
    history.replaceState(null, "", query ? `?${query}` : location.pathname);
  }

  function clearUrl() {
    history.replaceState(null, "", location.pathname);
  }

  function revealResults() {
    hasBuilt = true;
    results.hidden = false;
    hint.hidden = true;
    recompute();
  }

  function hideResults() {
    hasBuilt = false;
    results.hidden = true;
    hint.hidden = false;
    clearUrl();
  }

  function onSliderInput() {
    const weights = readWeights();
    updateSliderLabels(weights, readSubWeights());
    buildButton.disabled = totalWeight(weights) === 0;
    if (hasBuilt) recompute();
  }

  function applyFromUrl(): { hasWeights: boolean; hasSubWeights: boolean } {
    const params = new URLSearchParams(location.search);
    const w = params.get("w");
    if (!w) return { hasWeights: false, hasSubWeights: false };
    const values = w.split(",").map(Number);
    if (values.length !== categorySliders.length || values.some((v) => Number.isNaN(v))) {
      return { hasWeights: false, hasSubWeights: false };
    }
    categorySliders.forEach((s, i) => (s.value = String(values[i])));

    let hasSubWeights = false;
    const m = params.get("m");
    if (m) {
      const order = SUBWEIGHTED_CATEGORIES.flatMap((c) => c.metrics.map((mm) => mm.path));
      const mValues = m.split(",").map(Number);
      if (mValues.length === order.length && !mValues.some((v) => Number.isNaN(v))) {
        const byPath = new Map(order.map((path, i) => [path, mValues[i]]));
        subSliders.forEach((s) => {
          const v = byPath.get(s.dataset.metric!);
          if (v !== undefined) s.value = String(v);
        });
        hasSubWeights = true;
      }
    }
    return { hasWeights: totalWeight(readWeights()) > 0, hasSubWeights };
  }

  categorySliders.forEach((s) => s.addEventListener("input", onSliderInput));
  subSliders.forEach((s) => s.addEventListener("input", onSliderInput));
  buildButton.addEventListener("click", revealResults);
  advancedToggle.addEventListener("click", () => setAdvancedMode(!advancedMode));
  resetButton.addEventListener("click", () => {
    categorySliders.forEach((s) => (s.value = "0"));
    subSliders.forEach((s) => (s.value = String(DEFAULT_SUBWEIGHTS[s.dataset.metric!])));
    onSliderInput();
    hideResults();
    setAdvancedMode(false);
  });

  const { hasWeights: sharedWeightsPresent, hasSubWeights } = applyFromUrl();
  setAdvancedMode(hasSubWeights);
  updateSliderLabels(readWeights(), readSubWeights());
  buildButton.disabled = totalWeight(readWeights()) === 0;
  if (sharedWeightsPresent) revealResults();
</script>

<style>
  .display {
    font-size: clamp(2.1rem, 4.5vw, 3.2rem);
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  .subhead {
    color: var(--muted);
    max-width: 40em;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .cta {
    margin: 1.5rem 0 2rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.5rem;
    font-size: 0.95rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  th {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    user-select: none;
  }

  th[aria-sort="ascending"]::after {
    content: " \25B2";
  }

  th[aria-sort="descending"]::after {
    content: " \25BC";
  }

  td.score,
  td:nth-child(3) {
    font-weight: 600;
  }

  #rankings-table tbody tr td:first-child {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--accent);
  }

  .institution {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .unranked {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .unranked h2 {
    font-size: 1.4rem;
  }

  .marker {
    color: var(--accent);
    display: inline-block;
  }

  .customize {
    margin-top: 2.5rem;
    padding: 1rem 1.25rem 1.25rem;
    max-width: 30em;
    background: var(--accent-bg);
    border-left: 3px solid var(--accent);
  }

  .customize h2 {
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }

  .customize .subhead {
    margin: 0 0 0.9rem;
    max-width: none;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .sliders {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }

  .category-block {
    display: grid;
    gap: 0.3rem;
  }

  .slider-row {
    display: grid;
    grid-template-columns: minmax(0, 11rem) 1fr 2.4rem;
    align-items: center;
    gap: 0.6rem;
  }

  .slider-row label {
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .slider-value {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .sliders input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
    cursor: pointer;
    height: 1rem;
  }

  .advanced-toggle {
    font-size: 0.72rem;
    padding: 0.45rem 0.55rem;
    min-width: 8.5rem;
    text-align: center;
  }

  .subweight-list[hidden] {
    display: none;
  }

  .subweight-list {
    display: grid;
    gap: 0.3rem;
    margin: 0.3rem 0 0.2rem 1rem;
  }

  .subweight-label {
    margin: 0;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .slider-row.sub {
    grid-template-columns: minmax(0, 10rem) 1fr 2.4rem;
  }

  .slider-row.sub label {
    font-weight: 400;
    font-size: 0.68rem;
    color: var(--muted);
  }

  .slider-row.sub .slider-value {
    font-size: 0.72rem;
  }

  .customize-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-solid {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
    padding: 0.5rem 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .btn-solid:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  #reset-weights {
    padding: 0.5rem 0.65rem;
    font-size: 0.78rem;
  }

  .customize-hint {
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
    font-style: italic;
