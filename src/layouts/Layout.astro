---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Global Hospitality Program Rankings</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Global Hospitality Program Rankings</a>
      <nav>
        <a href="/">Rankings</a>
        <a href="/methodology/">Methodology</a>
        <a href="/sources/">Sources</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        An independent, source-cited ranking of undergraduate hospitality &amp; hotel administration programs.
        Not affiliated with any ranked institution.
      </p>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #666666;
    --border: #e0e0e0;
    --accent: #7a1f2b;
    --accent-bg: #fbeeef;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #15120f;
      --fg: #f0ece6;
      --muted: #a89f94;
      --border: #3a332c;
      --accent: #e3a6ab;
      --accent-bg: #2a1d1f;
    }
  }

  :global(html) {
    background: var(--bg);
    color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  }

  :global(body) {
    margin: 0;
    max-width: 960px;
    padding: 0 1rem;
    margin-inline: auto;
  }

  :global(a) {
    color: var(--accent);
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--fg);
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  main {
    padding: 2rem 0 4rem;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 0 3rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
